From 9a368661e9eb8078acb459b4e276c0127ab66f6e Mon Sep 17 00:00:00 2001
From: Rafael Diniz <rafael@riseup.net>
Date: Mon, 9 Nov 2026 23:15:10 +0000
Subject: [PATCH] fyne-ui: vendored GLFW takes Wayland touch as the left mouse
 button

On the Jolla, mercury-ui 1.9.23 drew and its waterfall ran, but no tap did
anything: Sailfish OS's compositor sends taps as wl_touch only, with no
wl_pointer, and GLFW (ours, and upstream 3.4) binds only the pointer and the
keyboard, so Fyne never got a click.

The seat's touch capability now binds a wl_touch.  Its first touch point
is the left button on the window's own surface: down moves the cursor there
and presses, motion moves it, up and cancel release.  Further points, and
the fallback decorations, are left alone.  Desktop pointers are unchanged.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../third_party/glfw-v3.4/glfw/src/wl_init.c  |   2 +
 .../glfw-v3.4/glfw/src/wl_platform.h          |   4 +
 .../glfw-v3.4/glfw/src/wl_window.c            | 124 ++++++++++++++++++
 3 files changed, 130 insertions(+)

diff --git a/gui_interface/fyne-ui/third_party/glfw-v3.4/glfw/src/wl_init.c b/gui_interface/fyne-ui/third_party/glfw-v3.4/glfw/src/wl_init.c
index 3aff476d..11b16522 100644
--- a/gui_interface/fyne-ui/third_party/glfw-v3.4/glfw/src/wl_init.c
+++ b/gui_interface/fyne-ui/third_party/glfw-v3.4/glfw/src/wl_init.c
@@ -971,6 +971,8 @@ void _glfwTerminateWayland(void)
         wl_pointer_destroy(_glfw.wl.pointer);
     if (_glfw.wl.keyboard)
         wl_keyboard_destroy(_glfw.wl.keyboard);
+    if (_glfw.wl.touch)
+        wl_touch_destroy(_glfw.wl.touch);
     if (_glfw.wl.seat)
         wl_seat_destroy(_glfw.wl.seat);
     if (_glfw.wl.relativePointerManager)
diff --git a/gui_interface/fyne-ui/third_party/glfw-v3.4/glfw/src/wl_platform.h b/gui_interface/fyne-ui/third_party/glfw-v3.4/glfw/src/wl_platform.h
index 149cd241..b84d69be 100644
--- a/gui_interface/fyne-ui/third_party/glfw-v3.4/glfw/src/wl_platform.h
+++ b/gui_interface/fyne-ui/third_party/glfw-v3.4/glfw/src/wl_platform.h
@@ -427,6 +427,7 @@ typedef struct _GLFWlibraryWayland
     struct wl_seat*             seat;
     struct wl_pointer*          pointer;
     struct wl_keyboard*         keyboard;
+    struct wl_touch*            touch;
     struct wl_data_device_manager*          dataDeviceManager;
     struct wl_data_device*      dataDevice;
     struct xdg_wm_base*         wmBase;
@@ -509,6 +510,9 @@ typedef struct _GLFWlibraryWayland
 
     _GLFWwindow*                pointerFocus;
     _GLFWwindow*                keyboardFocus;
+    // The window the first touch point went down on, and that point's id
+    _GLFWwindow*                touchFocus;
+    int32_t                     touchId;
 
     struct {
         void*                                       handle;
diff --git a/gui_interface/fyne-ui/third_party/glfw-v3.4/glfw/src/wl_window.c b/gui_interface/fyne-ui/third_party/glfw-v3.4/glfw/src/wl_window.c
index c990f020..4cc00d6a 100644
--- a/gui_interface/fyne-ui/third_party/glfw-v3.4/glfw/src/wl_window.c
+++ b/gui_interface/fyne-ui/third_party/glfw-v3.4/glfw/src/wl_window.c
@@ -1879,6 +1879,114 @@ static const struct wl_keyboard_listener keyboardListener =
     keyboardHandleRepeatInfo,
 };
 
+// Touch, as the left mouse button: a phone's compositor (Sailfish OS) sends
+// taps as wl_touch only, with no pointer.  The first touch point moves the
+// cursor to where it goes down and presses the button, moves it as it moves,
+// and releases it when it lifts or the compositor cancels it; further points
+// are ignored.  Only the window's own surface, not the fallback decorations.
+static void touchHandleDown(void* userData,
+                            struct wl_touch* touch,
+                            uint32_t serial,
+                            uint32_t time,
+                            struct wl_surface* surface,
+                            int32_t id,
+                            wl_fixed_t sx,
+                            wl_fixed_t sy)
+{
+    if (!surface || _glfw.wl.touchFocus)
+        return;
+
+    if (wl_proxy_get_tag((struct wl_proxy*) surface) != &_glfw.wl.tag)
+        return;
+
+    _GLFWwindow* window = wl_surface_get_user_data(surface);
+    if (!window || surface != window->wl.surface)
+        return;
+
+    _glfw.wl.serial = serial;
+    _glfw.wl.touchFocus = window;
+    _glfw.wl.touchId = id;
+
+    window->wl.cursorPosX = wl_fixed_to_double(sx);
+    window->wl.cursorPosY = wl_fixed_to_double(sy);
+    _glfwInputCursorPos(window, window->wl.cursorPosX, window->wl.cursorPosY);
+    _glfwInputMouseClick(window, GLFW_MOUSE_BUTTON_LEFT, GLFW_PRESS,
+                         _glfw.wl.xkb.modifiers);
+}
+
+static void touchHandleUp(void* userData,
+                          struct wl_touch* touch,
+                          uint32_t serial,
+                          uint32_t time,
+                          int32_t id)
+{
+    _GLFWwindow* window = _glfw.wl.touchFocus;
+    if (!window || id != _glfw.wl.touchId)
+        return;
+
+    _glfw.wl.serial = serial;
+    _glfw.wl.touchFocus = NULL;
+    _glfwInputMouseClick(window, GLFW_MOUSE_BUTTON_LEFT, GLFW_RELEASE,
+                         _glfw.wl.xkb.modifiers);
+}
+
+static void touchHandleMotion(void* userData,
+                              struct wl_touch* touch,
+                              uint32_t time,
+                              int32_t id,
+                              wl_fixed_t sx,
+                              wl_fixed_t sy)
+{
+    _GLFWwindow* window = _glfw.wl.touchFocus;
+    if (!window || id != _glfw.wl.touchId)
+        return;
+
+    window->wl.cursorPosX = wl_fixed_to_double(sx);
+    window->wl.cursorPosY = wl_fixed_to_double(sy);
+    _glfwInputCursorPos(window, window->wl.cursorPosX, window->wl.cursorPosY);
+}
+
+static void touchHandleFrame(void* userData, struct wl_touch* touch)
+{
+}
+
+static void touchHandleCancel(void* userData, struct wl_touch* touch)
+{
+    _GLFWwindow* window = _glfw.wl.touchFocus;
+    if (!window)
+        return;
+
+    _glfw.wl.touchFocus = NULL;
+    _glfwInputMouseClick(window, GLFW_MOUSE_BUTTON_LEFT, GLFW_RELEASE,
+                         _glfw.wl.xkb.modifiers);
+}
+
+static void touchHandleShape(void* userData,
+                             struct wl_touch* touch,
+                             int32_t id,
+                             wl_fixed_t major,
+                             wl_fixed_t minor)
+{
+}
+
+static void touchHandleOrientation(void* userData,
+                                   struct wl_touch* touch,
+                                   int32_t id,
+                                   wl_fixed_t orientation)
+{
+}
+
+static const struct wl_touch_listener touchListener =
+{
+    touchHandleDown,
+    touchHandleUp,
+    touchHandleMotion,
+    touchHandleFrame,
+    touchHandleCancel,
+    touchHandleShape,
+    touchHandleOrientation,
+};
+
 static void seatHandleCapabilities(void* userData,
                                    struct wl_seat* seat,
                                    enum wl_seat_capability caps)
@@ -1904,6 +2012,19 @@ static void seatHandleCapabilities(void* userData,
         wl_keyboard_destroy(_glfw.wl.keyboard);
         _glfw.wl.keyboard = NULL;
     }
+
+    if ((caps & WL_SEAT_CAPABILITY_TOUCH) && !_glfw.wl.touch)
+    {
+        _glfw.wl.touch = wl_seat_get_touch(seat);
+        wl_touch_add_listener(_glfw.wl.touch, &touchListener, NULL);
+    }
+    else if (!(caps & WL_SEAT_CAPABILITY_TOUCH) && _glfw.wl.touch)
+    {
+        // A press still held is released, as a cancel would
+        touchHandleCancel(NULL, _glfw.wl.touch);
+        wl_touch_destroy(_glfw.wl.touch);
+        _glfw.wl.touch = NULL;
+    }
 }
 
 static void seatHandleName(void* userData,
@@ -2185,6 +2306,9 @@ void _glfwDestroyWindowWayland(_GLFWwindow* window)
     if (window == _glfw.wl.keyboardFocus)
         _glfw.wl.keyboardFocus = NULL;
 
+    if (window == _glfw.wl.touchFocus)
+        _glfw.wl.touchFocus = NULL;
+
     if (window->wl.activationToken)
         xdg_activation_token_v1_destroy(window->wl.activationToken);
 
-- 
