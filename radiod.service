[Unit]
Description=HERMES radio controller daemon (hermes-radio-daemon)
After=network.target
# One radio controller per station: starting radiod stops hermes-net's
# sbitx controller (whose unit has Conflicts=radiod.service).
Conflicts=sbitx.service

[Service]
Type=exec
User=root
Group=root
SupplementaryGroups=ssl-cert
ExecStart=/usr/bin/radio_daemon -c 3
# Whatever way the daemon ended (clean stop, crash, SIGKILL after a hung
# shutdown), leave the transmitter in receive. "-": a radio that cannot be
# reached must not fail the unit.
ExecStopPost=-/usr/bin/radio_daemon --ptt-off
KillSignal=SIGTERM
IgnoreSIGPIPE=no
Restart=always
RestartSec=5
LimitNOFILE=65536

# WSS certificate paths (hardcoded in binary):
#   cert: /etc/ssl/certs/hermes.radio.crt   (644 root:ssl-cert)
#   key:  /etc/ssl/private/hermes.radio.key  (640 root:ssl-cert)
# Installed by hermes-installer certificate_setup.sh

[Install]
WantedBy=multi-user.target
