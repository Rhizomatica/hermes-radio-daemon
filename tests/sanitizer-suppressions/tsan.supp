# ThreadSanitizer suppressions for radiod's unit tests (make test SANITIZE=tsan).
#
# Policy, as mercury's: every entry has a one-line justification, and only
# known, triaged findings outside radiod's own code go here, so that a new
# race in radiod fails the run.  Format: race:<symbol or library substring>

# hamlib 4.6 writes its debug-message buffer (debugmsgsave2) from rig_open and
# its own threads without a lock; library-internal, not radiod's.
race:libhamlib.so

# libdatachannel is not built with -fsanitize=thread, so TSan does not see the
# std::future and atomics its threads synchronise with; every report has both
# accesses inside it (Certificate, Track, Transport), none in radiod's data.
# This also hides a race in radio_webrtc.c's callbacks, which run on its
# threads: their state is under radio_webrtc's own mutex.
race:libdatachannel.so
